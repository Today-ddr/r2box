# R2Box 环境变量配置

# ============================================
# 可选配置
# ============================================

# 服务器端口（默认: 9988）
PORT=9988

# 文件大小限制（默认: 5GB）
MAX_FILE_SIZE=5368709120

# 总存储空间（默认: 10GB，对应 R2 免费层）
# 注意：这是配额上限，超过后新的上传会被拒绝
TOTAL_STORAGE=10737418240

# 数据库路径（默认: ./data/r2box.db）
DATABASE_PATH=./data/r2box.db

# 受信反向代理网段（逗号分隔 CIDR）
# 只有来自这些网段的请求才会解析 X-Forwarded-For 来识别真实客户端 IP
# 直接暴露端口时不要设置；挂了 nginx/caddy 时填代理所在网段，如 127.0.0.1/32
# TRUSTED_PROXIES=127.0.0.1/32

# ============================================
# 说明
# ============================================

# 登录密码在首次访问 Web 界面时设置，存储在数据库中，不通过环境变量配置
# R2 配置同样在首次登录后通过 Web 界面设置
